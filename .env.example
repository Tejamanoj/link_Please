# ─────────────────────────────────────────────
# LinkPlease — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────

# PseudoGram mock API key (required)
PSEUDOGRAM_API_KEY=

# PseudoGram API base URL
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Database connection string
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./linkplease.db
# PostgreSQL (production on Render):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Maximum number of DM retry attempts before marking a job as failed
MAX_DM_RETRIES=3

# Set to true in production to enforce HMAC-SHA256 webhook signature verification.
# Set to false for local development / testing with unsigned requests.
WEBHOOK_SIGNATURE_REQUIRED=true

# Internal alias — same value as PSEUDOGRAM_API_KEY (used for HMAC verification)
WEBHOOK_SECRET=
